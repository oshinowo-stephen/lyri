generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildPlayer {
  djRole               String?
  adminRole            String?
  guildId              String  @id
  leaveOnEmpty         Boolean @default(false)
  leaveOnEmptyDuration Int     @default(10)
}
